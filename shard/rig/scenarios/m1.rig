exec f=alpha/data/Mindustry/last_log.txt; s=server/server.log; read c0 s0 < m1.lines 2>/dev/null || { c0=0; s0=0; }; bad=$(tail -n +$((c0+1)) $f | grep -E 'Missing entity|ID mismatch|[Mm]ismatch|Error reading entity snapshot|[Dd]esync|Exception|\[E\]' | grep -vE 'OpenGL|GL context|GLXBadFBConfig|community servers|cdn.jsdelivr.net' | head -3; tail -n +$((s0+1)) $s | grep -E 'ERROR|Exception|WARN' | grep -vE 'stalled for [0-9]+ ms|ticks behind; dropping them' | head -3); echo "$(wc -l < $f) $(wc -l < $s)" > m1.lines; if [ -z "$bad" ]; then printf 'glacier\tclean\n' >> m1-maps.tsv; else printf 'glacier\tFAIL\t%s\n' "$(echo $bad)" >> m1-maps.tsv; fi

# 18. passage
alpha: rejoin
wait log server /\(alpha\) has connected to passage / 30s
alpha: expect js "Vars.world.width() + 'x' + Vars.world.height()" /^500x120$/ 10s
alpha: expect js "Vars.player.team().cores().size" /^2(\.0)?$/ 10s
alpha: expect js "Vars.player.team().cores().select(function(c){ return Vars.world.build(c.tileX(), c.tileY()) == c && c.block instanceof Packages.mindustry.world.blocks.storage.CoreBlock; }).size" /^2(\.0)?$/ 10s
alpha: shot 18-passage
alpha: mark
alpha: hold D 700ms
alpha: hold W 700ms
alpha: expect moved 2
alpha: wait 120t
alpha: expect connected
alpha: shot 18-passage-walked
exec f=alpha/data/Mindustry/last_log.txt; s=server/server.log; read c0 s0 < m1.lines 2>/dev/null || { c0=0; s0=0; }; bad=$(tail -n +$((c0+1)) $f | grep -E 'Missing entity|ID mismatch|[Mm]ismatch|Error reading entity snapshot|[Dd]esync|Exception|\[E\]' | grep -vE 'OpenGL|GL context|GLXBadFBConfig|community servers|cdn.jsdelivr.net' | head -3; tail -n +$((s0+1)) $s | grep -E 'ERROR|Exception|WARN' | grep -vE 'stalled for [0-9]+ ms|ticks behind; dropping them' | head -3); echo "$(wc -l < $f) $(wc -l < $s)" > m1.lines; if [ -z "$bad" ]; then printf 'passage\tclean\n' >> m1-maps.tsv; else printf 'passage\tFAIL\t%s\n' "$(echo $bad)" >> m1-maps.tsv; fi

exec cat m1-maps.tsv; [ "$(grep -c 'clean$' m1-maps.tsv)" = 18 ] || echo "not every map is clean"
console status
wait log server /Status: 18 worlds, 1 players?/ 10s
assert log server !/Exception|ERROR/ after /ready: 18 worlds hosted/
assert clean all
# No server WARN line, except the two a busy VM makes: the watchdog's "stalled for N ms" and the scheduler's "N ticks
# behind; dropping them" (m0.rig's last assert). Tick lag has its own gates.
assert log server !/^\S+ WARN ++(?!\[tick-watchdog\] \S+ - world \S+ stalled for \d+ ms|\[tick-\d+\] \S+ - world \S+ is \d+ ticks behind; dropping them until it keeps up)/
