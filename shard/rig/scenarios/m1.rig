# M1 (ARCHITECTURE.md §10) on a stock client (L5): a vanilla client joins each of the 18 default maps, walks, sees its
# cores, and logs no desync line. Shard hosts all 18 and deals joins round-robin, so alpha's 18 joins land on the maps
# in vanilla's order (Maps.defaultMapNames). On each map alpha:
#  - joins (the server log names the map), and its world has the map's size;
#  - sees its team's cores (as many as the map file has: passage has two), on screen at the spawn (the shot);
#  - walks right then up (at least 2 tiles from where it spawned);
#  - then `exec` records the map in m1-maps.tsv: "clean", or "FAIL" with the first new desync or error lines of the
#    client's log, the rig's startup noise aside (GL probing, the offline server-list fetch) (Missing entity, ID mismatch, Error reading entity snapshot, desync, exceptions) and new server
#    ERROR/WARN lines (the two load lines m0.rig excuses aside) since the map before. It never fails the step, so
#    every map is recorded; the end-of-run checks then fail the run on any of them.
# The end-of-run checks fail on errors and desync lines in alpha's log, and on any server WARN line but the two known
# load ones (m0.rig's last assert).
#
#   scripts/vm-gradle.sh :server:installDist
#   rig/run.sh --vm "$(cat .vm-id)" --type large --clients 1 --script rig/scenarios/m1.rig --server \
#     'PUSH=/home/user/shard/server/build/install/shard exec "$RIG"/vm/shard-server.sh --join round-robin maze fortress labyrinth islands tendrils caldera wasteland shattered fork triad mudFlats moltenLake archipelago debrisField domain veins glacier passage'
timeout 40m

# the server listens before it has hosted every world; join once it has
wait port 360s
wait log server /ready: 18 worlds hosted/ 180s


# 01. maze
alpha: join
wait log server /\(alpha\) has connected to maze / 30s
alpha: expect js "Vars.world.width() + 'x' + Vars.world.height()" /^256x256$/ 10s
alpha: expect js "Vars.player.team().cores().size" /^1(\.0)?$/ 10s
alpha: expect js "Vars.player.team().cores().select(function(c){ return Vars.world.build(c.tileX(), c.tileY()) == c && c.block instanceof Packages.mindustry.world.blocks.storage.CoreBlock; }).size" /^1(\.0)?$/ 10s
alpha: shot 01-maze
alpha: mark
alpha: hold D 700ms
alpha: hold W 700ms
alpha: expect moved 2
alpha: wait 120t
alpha: expect connected
alpha: shot 01-maze-walked
exec f=alpha/data/Mindustry/last_log.txt; s=server/server.log; read c0 s0 < m1.lines 2>/dev/null || { c0=0; s0=0; }; bad=$(tail -n +$((c0+1)) $f | grep -E 'Missing entity|ID mismatch|[Mm]ismatch|Error reading entity snapshot|[Dd]esync|Exception|\[E\]' | grep -vE 'OpenGL|GL context|GLXBadFBConfig|community servers|cdn.jsdelivr.net' | head -3; tail -n +$((s0+1)) $s | grep -E 'ERROR|Exception|WARN' | grep -vE 'stalled for [0-9]+ ms|ticks behind; dropping them' | head -3); echo "$(wc -l < $f) $(wc -l < $s)" > m1.lines; if [ -z "$bad" ]; then printf 'maze\tclean\n' >> m1-maps.tsv; else printf 'maze\tFAIL\t%s\n' "$(echo $bad)" >> m1-maps.tsv; fi

# 02. fortress
alpha: rejoin
wait log server /\(alpha\) has connected to fortress / 30s
alpha: expect js "Vars.world.width() + 'x' + Vars.world.height()" /^256x256$/ 10s
alpha: expect js "Vars.player.team().cores().size" /^1(\.0)?$/ 10s
alpha: expect js "Vars.player.team().cores().select(function(c){ return Vars.world.build(c.tileX(), c.tileY()) == c && c.block instanceof Packages.mindustry.world.blocks.storage.CoreBlock; }).size" /^1(\.0)?$/ 10s
alpha: shot 02-fortress
alpha: mark
alpha: hold D 700ms
alpha: hold W 700ms
alpha: expect moved 2
alpha: wait 120t
alpha: expect connected
alpha: shot 02-fortress-walked
exec f=alpha/data/Mindustry/last_log.txt; s=server/server.log; read c0 s0 < m1.lines 2>/dev/null || { c0=0; s0=0; }; bad=$(tail -n +$((c0+1)) $f | grep -E 'Missing entity|ID mismatch|[Mm]ismatch|Error reading entity snapshot|[Dd]esync|Exception|\[E\]' | grep -vE 'OpenGL|GL context|GLXBadFBConfig|community servers|cdn.jsdelivr.net' | head -3; tail -n +$((s0+1)) $s | grep -E 'ERROR|Exception|WARN' | grep -vE 'stalled for [0-9]+ ms|ticks behind; dropping them' | head -3); echo "$(wc -l < $f) $(wc -l < $s)" > m1.lines; if [ -z "$bad" ]; then printf 'fortress\tclean\n' >> m1-maps.tsv; else printf 'fortress\tFAIL\t%s\n' "$(echo $bad)" >> m1-maps.tsv; fi

