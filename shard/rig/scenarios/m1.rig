alpha: expect js "Vars.player.team().cores().size" /^1(\.0)?$/ 10s
alpha: expect js "Vars.player.team().cores().select(function(c){ return Vars.world.build(c.tileX(), c.tileY()) == c && c.block instanceof Packages.mindustry.world.blocks.storage.CoreBlock; }).size" /^1(\.0)?$/ 10s
alpha: shot 16-veins
alpha: mark
alpha: hold D 700ms
alpha: hold W 700ms
alpha: expect moved 2
alpha: wait 120t
alpha: expect connected
alpha: shot 16-veins-walked
exec f=alpha/data/Mindustry/last_log.txt; s=server/server.log; read c0 s0 < m1.lines 2>/dev/null || { c0=0; s0=0; }; bad=$(tail -n +$((c0+1)) $f | grep -E 'Missing entity|ID mismatch|[Mm]ismatch|Error reading entity snapshot|[Dd]esync|Exception|\[E\]' | grep -vE 'OpenGL|GL context|GLXBadFBConfig|community servers|cdn.jsdelivr.net' | head -3; tail -n +$((s0+1)) $s | grep -E 'ERROR|Exception|WARN' | grep -vE 'stalled for [0-9]+ ms|ticks behind; dropping them' | head -3); echo "$(wc -l < $f) $(wc -l < $s)" > m1.lines; if [ -z "$bad" ]; then printf 'veins\tclean\n' >> m1-maps.tsv; else printf 'veins\tFAIL\t%s\n' "$(echo $bad)" >> m1-maps.tsv; fi

