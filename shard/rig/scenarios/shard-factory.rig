# W4.1 (WP66) on Shard, 2 stock clients on factory.msav (FactoryMap.java: a core and an air factory at (14, 10),
# powered and stocked, units 10x as fast). alpha taps the factory, which opens its config table, and picks mono, then
# a command, sending what the table's buttons send (build.configure(index), build.configure(command): Call.tileConfig). The server
# applies both and forwards them: bravo's factory shows the same plan and command. The factory builds monos, pushes them
# out (unitBlockSpawn) and each takes the configured command, which both clients read off the synced controller.
# Clearing the command (configure(null), a double tap) goes back to the type's default for the next mono. bravo's
# rejoin reads the plan from the server's world stream.
#
#   rig/run.sh --vm "$(cat .vm-id)" --server 'mkdir -p maps && cp ~/shard/rig/scenarios/factory.msav maps/ \
#     && PUSH=~/shard/server/build/install/shard exec "$RIG"/vm/shard-server.sh "factory sandbox"' \
#     --clients 2 --script rig/scenarios/shard-factory.rig
timeout 8m

wait port 120s
alpha: join
bravo: join
all: expect tile 14 10 air-factory 30s
all: expect js "Vars.world.build(14,10).currentPlan" /^0(\.0)?$/ 10s
all: shot joined

# alpha taps the factory: its config table opens on the client
alpha: click left tile 14 10
alpha: expect js "Vars.control.input.config.isShown()" /^true$/ 10s
all: shot config-open

# mono, as its button sends it: configure(plans.indexOf(mono)), an int 1. new java.lang.Integer keeps it a Java Integer:
# Rhino turns Integer.valueOf's result, and any JS number, into a Double, which no config handler takes
alpha: expect js "(function(){Vars.world.build(14,10).configure(new java.lang.Integer(1));return 'sent'})()" /^sent$/ 10s
all: expect js "Vars.world.build(14,10).currentPlan" /^1(\.0)?$/ 10s
console tile factory 14 10
wait log server /^tile 14,10 .*air-factory/ 10s

# a command: move, which monos have besides their default (mine)
alpha: expect js "(function(){Vars.world.build(14,10).configure(UnitCommand.moveCommand);return 'sent'})()" /^sent$/ 10s
all: expect js "Vars.world.build(14,10).command == null ? 'none' : Vars.world.build(14,10).command.name" /^move$/ 10s
alpha: click left tile 20 20
all: shot configured

# a mono comes out with the command, on both clients
all: expect js "Groups.unit.count(function(u){return u.type == UnitTypes.mono})" /^[1-9]/ 60s
all: expect js "(function(){var m = Groups.unit.find(function(u){return u.type == UnitTypes.mono});return m.isCommandable() ? m.command().command.name : 'none'})()" /^move$/ 10s
all: shot mono-made

# null clears the command: the next mono takes its default, mine
alpha: expect js "(function(){Vars.world.build(14,10).configure(null);return 'sent'})()" /^sent$/ 10s
all: expect js "Vars.world.build(14,10).command == null ? 'none' : Vars.world.build(14,10).command.name" /^none$/ 10s
all: expect js "Groups.unit.count(function(u){return u.type == UnitTypes.mono && u.isCommandable() && u.command().command == UnitCommand.mineCommand})" /^[1-9]/ 60s

# the server's own state, in a fresh world stream: the plan is mono
bravo: rejoin
bravo: expect js "Vars.world.build(14,10).currentPlan" /^1(\.0)?$/ 10s
all: shot rejoined
assert clean
