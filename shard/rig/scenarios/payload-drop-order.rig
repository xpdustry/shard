# W4.5 (Q215): after a payload drop, both clients place the dropped building. shard-payloads.rig's steps up to the
# container's lift, then one drop, and the clients' own tiles are checked, which W3.9 had to leave out: 3 of 4 client
# views missed the building when Shard sent UDP snapshots at once and TCP Calls from a writer thread.
#
# bravo logs, in its own client, what reaches it around the drop: each payloadDropped Call and each entity snapshot,
# with the mega's payload count when it arrives. If the snapshot that empties the mega comes first, the Call has
# nothing left to drop (Q215); bravo's log in the run's order.tsv shows which.
#
#   rig/run.sh --vm "$(cat .vm-id)" --server 'mkdir -p maps && cp ~/shard/rig/scenarios/payloads.msav maps/ \
#     && PUSH=~/shard/server/build/install/shard exec "$RIG"/vm/shard-server.sh "payloads sandbox"' \
#     --clients 2 --script rig/scenarios/payload-drop-order.rig
timeout 6m

wait port 120s
alpha: join
bravo: join

# the mega, from alpha's core unit
alpha: expect js "(function(){Call.unitControl(Vars.player, Groups.unit.find(function(u){return u.type == UnitTypes.mega}));return 'sent'})()" /^sent$/ 10s
alpha: expect js "Vars.player.unit().type.name" /^mega$/ 10s
bravo: expect js "Groups.unit.find(function(u){return u.type == UnitTypes.mega}).isPlayer()" /^true$/ 10s

# the dagger lifted and set down, as in shard-payloads.rig, so the drop below lands where W3.9's did
alpha: press OPEN_BRACKET
alpha: expect js "Vars.player.unit().payloads.size" /^1(\.0)?$/ 10s
alpha: press CLOSE_BRACKET
alpha: expect js "Vars.player.unit().payloads.size" /^0(\.0)?$/ 10s
bravo: expect js "Groups.unit.count(function(u){return u.type == UnitTypes.dagger})" /^1(\.0)?$/ 10s

# the container: requestBuildPayload, then pickedBuildPayload; bravo's mega holds it with its copper
alpha: expect js "(function(){Call.requestBuildPayload(Vars.player, Vars.world.build(14, 8));return 'sent'})()" /^sent$/ 10s
alpha: expect js "Vars.player.unit().payloads.size" /^1(\.0)?$/ 10s
bravo: expect js "(function(){var m = Groups.unit.find(function(u){return u.type == UnitTypes.mega});return m.payloads.size + ' ' + (m.payloads.size > 0 ? m.payloads.peek().build.items.get(Items.copper) : '-')})()" /^1 50$/ 10s

# bravo's log: listeners run in place of the default handler, so each calls it
bravo: expect js "(function(){var t0 = Time.millis(); this.rigOrder = []; var mega = function(){var m = Groups.unit.find(function(u){return u.type == UnitTypes.mega}); return m == null ? -1 : m.payloads.size}; var log = function(what){rigOrder.push((Time.millis() - t0) + ':' + what + ':' + mega())}; Vars.net.handleClient(Packages.mindustry.gen.PayloadDroppedCallPacket, function(p){log('call'); p.handleClient(); log('placed=' + (Vars.world.build(18, 12) != null))}); Vars.net.handleClient(Packages.mindustry.gen.EntitySnapshotCallPacket, function(p){var before = mega(); p.handleClient(); if(before != mega()) log('snapshot-from-' + before)}); return 'hooked'})()" /^hooked$/ 10s

# the drop, at (145, 98): tile (18, 12) for a 2x2 block, clear of the dagger
alpha: expect js "(function(){Call.requestDropPayload(Vars.player, 145, 98);return 'sent'})()" /^sent$/ 10s
alpha: expect js "Vars.player.unit().payloads.size" /^0(\.0)?$/ 10s
console tile payloads 18 12
wait log server /^tile 18,12 .* block=container / 10s
wait 1s
bravo: sample js "rigOrder.join(' ')" every 500ms for 1s to order.tsv
# both clients placed it, with its copper
alpha: expect js "(function(){var b = Vars.world.build(18, 12); return b == null ? 'none' : b.block.name + ' ' + b.items.get(Items.copper)})()" /^container 50$/ 5s
bravo: expect js "(function(){var b = Vars.world.build(18, 12); return b == null ? 'none' : b.block.name + ' ' + b.items.get(Items.copper)})()" /^container 50$/ 5s
all: shot dropped

assert clean all
assert clean server
