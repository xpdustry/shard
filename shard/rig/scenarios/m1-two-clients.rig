exec s=server/server.log; read a0 b0 s0 < m1.lines 2>/dev/null || { a0=0; b0=0; s0=0; }; bad=$(for c in alpha:$a0 bravo:$b0; do n=${c%%:*}; o=${c##*:}; tail -n +$((o+1)) $n/data/Mindustry/last_log.txt | grep -E 'Missing entity|ID mismatch|[Mm]ismatch|Error reading entity snapshot|[Dd]esync|Exception|\[E\]' | grep -vE 'OpenGL|GL context|GLXBadFBConfig|community servers|cdn.jsdelivr.net' | head -3 | sed "s/^/$n: /"; done; tail -n +$((s0+1)) $s | grep -E 'ERROR|Exception|WARN' | grep -vE 'stalled for [0-9]+ ms|ticks behind; dropping them' | head -3); echo "$(wc -l < alpha/data/Mindustry/last_log.txt) $(wc -l < bravo/data/Mindustry/last_log.txt) $(wc -l < $s)" > m1.lines; if [ -z "$bad" ]; then printf 'caldera\talpha joined, bravo moved in\tclean\n' >> m1-maps.tsv; else printf 'caldera\talpha joined, bravo moved in\tFAIL\t%s\n' "$(echo $bad)" >> m1-maps.tsv; fi

