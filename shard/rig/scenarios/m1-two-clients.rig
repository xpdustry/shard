exec s=server/server.log; read a0 b0 s0 < m1.lines 2>/dev/null || { a0=0; b0=0; s0=0; }; bad=$(for c in alpha:$a0 bravo:$b0; do n=${c%%:*}; o=${c##*:}; tail -n +$((o+1)) $n/data/Mindustry/last_log.txt | grep -E 'Missing entity|ID mismatch|[Mm]ismatch|Error reading entity snapshot|[Dd]esync|Exception|\[E\]' | grep -vE 'OpenGL|GL context|GLXBadFBConfig|community servers|cdn.jsdelivr.net' | head -3 | sed "s/^/$n: /"; done; tail -n +$((s0+1)) $s | grep -E 'ERROR|Exception|WARN' | grep -vE 'stalled for [0-9]+ ms|ticks behind; dropping them' | head -3); echo "$(wc -l < alpha/data/Mindustry/last_log.txt) $(wc -l < bravo/data/Mindustry/last_log.txt) $(wc -l < $s)" > m1.lines; if [ -z "$bad" ]; then printf 'triad\talpha joined, bravo moved in\tclean\n' >> m1-maps.tsv; else printf 'triad\talpha joined, bravo moved in\tFAIL\t%s\n' "$(echo $bad)" >> m1-maps.tsv; fi

# 10. mud-flats: bravo joins, alpha moves in from triad
bravo: rejoin
wait log server /\(bravo\) has connected to mud-flats / 30s
alpha: chat "/world mud-flats"
wait log server /\(alpha\) moves from triad to mud-flats/ 15s
wait log server /\(alpha\) receives mud-flats/ 30s
all: expect js "m1erekir = function(){ return Vars.state.rules.planet == Packages.mindustry.content.Planets.erekir; }; m1a = function(){ return m1erekir() ? Blocks.duct : Blocks.conveyor; }; m1b = function(){ return m1erekir() ? Blocks.berylliumWall : Blocks.copperWall; }; m1find = function(n){ for(var i = 0; i < Groups.player.size(); i++){ var p = Groups.player.index(i); if(p.plainName() == n) return p; } return null; }; m1counts = function(){ var d = Vars.player.team().data(); return d.getBuildings(m1a()).size + ',' + d.getBuildings(m1b()).size; }; m1grew = function(){ var b = m1base.split(','), n = m1counts().split(','); return (n[0] - b[0]) + ',' + (n[1] - b[1]); }; m1near = function(block, n){ var p = m1find(n); if(p == null) return -1; var s = Vars.player.team().data().getBuildings(block), c = 0; for(var i = 0; i < s.size; i++) if(s.get(i).within(p.x, p.y, 12 * 8)) c++; return c; }; m1place = function(block, sign){ var t = Vars.player.team(), px = Vars.player.tileX(), py = Vars.player.tileY(); for(var side = 0; side < 2; side++) for(var r = 3; r <= 12; r++) for(var d = 0; d <= 2 * r; d++){ var x = px + (side == 0 ? sign : -sign) * r, y = py + (d % 2 == 0 ? d / 2 : -(d + 1) / 2); if(Packages.mindustry.world.Build.validPlace(block, t, x, y, 0)){ Vars.player.unit().addBuild(new Packages.mindustry.entities.units.BuildPlan(x, y, 0, block)); return 'queued ' + x + ',' + y; } } return 'nowhere'; }; m1at = function(n){ var p = m1find(n); return p == null ? null : [p.x, p.y]; }; m1dst = function(n, from){ var p = m1find(n); if(p == null || from == null) return -1; var dx = p.x - from[0], dy = p.y - from[1]; return Math.sqrt(dx * dx + dy * dy) / 8; }; 'ok'" /^ok$/ 10s
all: expect js "Vars.world.width() + 'x' + Vars.world.height()" /^400x400$/ 30s
all: expect js "!Vars.player.dead()" /^true$/ 60s
all: expect js "Vars.player.team().cores().size" /^1(\.0)?$/ 10s
all: expect js "Vars.player.team().cores().select(function(c){ return Vars.world.build(c.tileX(), c.tileY()) == c && c.block instanceof Packages.mindustry.world.blocks.storage.CoreBlock; }).size" /^1(\.0)?$/ 10s
