# M1 (ARCHITECTURE.md §10) on two stock clients (L5): both clients on each of the 18 default maps, each seeing the
# other's unit move and the other's blocks, with no desync line. Generated: edit m1-two-clients.py and rerun it
# (python3 rig/scenarios/m1-two-clients.py > rig/scenarios/m1-two-clients.rig).
# Shard hosts the 18 maps with `--join round-robin`, so every join lands on the next map in vanilla's order
# (Maps.defaultMapNames). bravo's first join takes maze; then each map takes exactly one more join, alternating
# alpha and bravo, and the other client follows with `/world <map>` (a transfer, which doesn't move the round robin):
# fortress, labyrinth, ..., passage, and maze again at the end. On each map both clients check, on their own client:
#   - the world has the map's size, and they see their team's cores (as many as the map has: passage has two);
#   - the other player is where its own client says (`expect player ... within 2`);
#   - alpha queues a conveyor and bravo a copper wall (on Erekir maps a duct and a beryllium wall) through its own
#     unit's build plans, each on the first valid tile 3 to 12 tiles east (alpha) or west (bravo) of it, else on the
#     other side; both see both blocks built, one of each more on the team, each near the player that built it;
#   - bravo walks, and alpha sees bravo's unit move at least 2 tiles and stand where bravo's client says; then the same
#     the other way round;
#   - then `exec` records the map in m1-maps.tsv: "clean", or "FAIL" with the first new desync or error lines of either
#     client's log (the rig's startup noise aside) and new server ERROR/WARN lines (the two load lines m0.rig excuses
#     aside) since the map before. It never fails the step, so every map is recorded; the end-of-run checks fail the run.
#
#   scripts/vm-gradle.sh :server:installDist
#   rig/run.sh --vm "$(cat .vm-id)" --type large --clients 2 --script rig/scenarios/m1-two-clients.rig --server \
#     'PUSH=/home/user/shard/server/build/install/shard exec "$RIG"/vm/shard-server.sh --join round-robin maze fortress labyrinth islands tendrils caldera wasteland shattered fork triad mudFlats moltenLake archipelago debrisField domain veins glacier passage'
timeout 75m

# the server listens before it has hosted every world; join once it has
wait port 360s
wait log server /ready: 18 worlds hosted/ 180s
# every world's core full, so the build plans never wait on copper
console fillitems

# bravo's join takes maze, the round robin's first world; it waits there for alpha's first join, which takes fortress
bravo: join
wait log server /\(bravo\) has connected to maze / 30s

# 01. fortress: alpha joins, bravo moves in from maze
alpha: join
wait log server /\(alpha\) has connected to fortress / 30s
bravo: chat "/world fortress"
wait log server /\(bravo\) moves from maze to fortress/ 15s
wait log server /\(bravo\) receives fortress/ 30s
all: expect js "m1erekir = function(){ return Vars.state.rules.planet == Packages.mindustry.content.Planets.erekir; }; m1a = function(){ return m1erekir() ? Blocks.duct : Blocks.conveyor; }; m1b = function(){ return m1erekir() ? Blocks.berylliumWall : Blocks.copperWall; }; m1find = function(n){ for(var i = 0; i < Groups.player.size(); i++){ var p = Groups.player.index(i); if(p.plainName() == n) return p; } return null; }; m1counts = function(){ var d = Vars.player.team().data(); return d.getBuildings(m1a()).size + ',' + d.getBuildings(m1b()).size; }; m1grew = function(){ var b = m1base.split(','), n = m1counts().split(','); return (n[0] - b[0]) + ',' + (n[1] - b[1]); }; m1near = function(block, n){ var p = m1find(n); if(p == null) return -1; var s = Vars.player.team().data().getBuildings(block), c = 0; for(var i = 0; i < s.size; i++) if(s.get(i).within(p.x, p.y, 12 * 8)) c++; return c; }; m1place = function(block, sign){ var t = Vars.player.team(), px = Vars.player.tileX(), py = Vars.player.tileY(); for(var side = 0; side < 2; side++) for(var r = 3; r <= 12; r++) for(var d = 0; d <= 2 * r; d++){ var x = px + (side == 0 ? sign : -sign) * r, y = py + (d % 2 == 0 ? d / 2 : -(d + 1) / 2); if(Packages.mindustry.world.Build.validPlace(block, t, x, y, 0)){ Vars.player.unit().addBuild(new Packages.mindustry.entities.units.BuildPlan(x, y, 0, block)); return 'queued ' + x + ',' + y; } } return 'nowhere'; }; m1at = function(n){ var p = m1find(n); return p == null ? null : [p.x, p.y]; }; m1dst = function(n, from){ var p = m1find(n); if(p == null || from == null) return -1; var dx = p.x - from[0], dy = p.y - from[1]; return Math.sqrt(dx * dx + dy * dy) / 8; }; 'ok'" /^ok$/ 10s
all: expect js "Vars.world.width() + 'x' + Vars.world.height()" /^256x256$/ 30s
all: expect js "!Vars.player.dead()" /^true$/ 60s
all: expect js "Vars.player.team().cores().size" /^1(\.0)?$/ 10s
all: expect js "Vars.player.team().cores().select(function(c){ return Vars.world.build(c.tileX(), c.tileY()) == c && c.block instanceof Packages.mindustry.world.blocks.storage.CoreBlock; }).size" /^1(\.0)?$/ 10s
alpha: expect player bravo within 2 20s
bravo: expect player alpha within 2 20s
all: expect js "m1base = m1counts(); m1base" /^\d+,\d+$/ 10s
alpha: expect js "m1place(m1a(), 1)" /^queued -?\d+,-?\d+$/ 10s
bravo: expect js "m1place(m1b(), -1)" /^queued -?\d+,-?\d+$/ 10s
all: expect js "m1grew()" /^1,1$/ 60s
all: expect js "m1near(m1a(), 'alpha') >= 1 && m1near(m1b(), 'bravo') >= 1" /^true$/ 10s
all: shot 01-fortress
alpha: expect js "m1from = m1at('bravo'); m1from != null" /^true$/ 10s
bravo: mark
bravo: hold D 700ms
bravo: hold W 700ms
bravo: expect moved 2
alpha: expect js "m1dst('bravo', m1from) >= 2" /^true$/ 10s
alpha: expect player bravo within 2 10s
bravo: expect js "m1from = m1at('alpha'); m1from != null" /^true$/ 10s
alpha: mark
alpha: hold D 700ms
alpha: hold W 700ms
alpha: expect moved 2
bravo: expect js "m1dst('alpha', m1from) >= 2" /^true$/ 10s
bravo: expect player alpha within 2 10s
all: wait 120t
all: expect connected
exec s=server/server.log; read a0 b0 s0 < m1.lines 2>/dev/null || { a0=0; b0=0; s0=0; }; bad=$(for c in alpha:$a0 bravo:$b0; do n=${c%%:*}; o=${c##*:}; tail -n +$((o+1)) $n/data/Mindustry/last_log.txt | grep -E 'Missing entity|ID mismatch|[Mm]ismatch|Error reading entity snapshot|[Dd]esync|Exception|\[E\]' | grep -vE 'OpenGL|GL context|GLXBadFBConfig|community servers|cdn.jsdelivr.net' | head -3 | sed "s/^/$n: /"; done; tail -n +$((s0+1)) $s | grep -E 'ERROR|Exception|WARN' | grep -vE 'stalled for [0-9]+ ms|ticks behind; dropping them' | head -3); echo "$(wc -l < alpha/data/Mindustry/last_log.txt) $(wc -l < bravo/data/Mindustry/last_log.txt) $(wc -l < $s)" > m1.lines; if [ -z "$bad" ]; then printf 'fortress\talpha joined, bravo moved in\tclean\n' >> m1-maps.tsv; else printf 'fortress\talpha joined, bravo moved in\tFAIL\t%s\n' "$(echo $bad)" >> m1-maps.tsv; fi

# 02. labyrinth: bravo joins, alpha moves in from fortress
bravo: rejoin
wait log server /\(bravo\) has connected to labyrinth / 30s
alpha: chat "/world labyrinth"
wait log server /\(alpha\) moves from fortress to labyrinth/ 15s
wait log server /\(alpha\) receives labyrinth/ 30s
